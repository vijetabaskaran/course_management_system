# ==============================================================================
# EduPortal React Frontend (Vite) — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env or .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel (Production), configure these under Project Settings -> Environment Variables.
# NOTE: In Vite, variables must be prefixed with VITE_ to be exposed to client-side code.
# ==============================================================================

# REST API Base URL
# Local: http://localhost:4000
# Production (Vercel): https://<your-render-backend>.onrender.com (NO trailing slash)
VITE_API_URL=http://localhost:4000

# Socket.IO Real-Time Server URL
# Local: http://localhost:4000
# Production (Vercel): https://<your-render-backend>.onrender.com (NO trailing slash)
VITE_SOCKET_URL=http://localhost:4000
