# EduPortal Express Backend Environment Variables
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars
JWT_EXPIRES_IN=1h

# MongoDB connection (local Community Server)
MONGODB_URI=mongodb://127.0.0.1:27017/studentportal

# Administrator Account Setup (Task 11 RBAC)
# Used by backend/scripts/createAdmin.js
# Admin password MUST be at least 12 characters
ADMIN_EMAIL=admin@eduportal.com
ADMIN_PASSWORD=replace_with_strong_password_min_12_chars
ADMIN_FULLNAME=System Administrator
