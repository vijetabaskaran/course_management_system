# ==============================================================================
# EduPortal Express Backend — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render (Production), configure these under Service -> Environment Variables.
# NEVER commit the actual .env file or production secrets to Git.
# ==============================================================================

# Server Environment & Port
# Local: development, 4000
# Render: production (Render injects PORT dynamically; 4000 is the local default)
NODE_ENV=development
PORT=4000

# CORS Allowed Origins
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production (Render): https://<your-vercel-app>.vercel.app (comma-separated, NO trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JSON Web Token Configuration
# JWT_SECRET: Must be a cryptographically secure random string (minimum 32 characters in production)
# JWT_EXPIRES_IN: Token lifespan (e.g. 1h, 2h, 7d)
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars
JWT_EXPIRES_IN=1h

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/studentportal
# Production (MongoDB Atlas):
#   mongodb+srv://<db_username>:<db_password>@<cluster-subdomain>.mongodb.net/studentportal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/studentportal

# Initial Administrator Account Setup (Task 11 & Task 15)
# Used by backend/scripts/createAdmin.js (npm run create-admin)
# ADMIN_PASSWORD must be at least 12 characters long for security
ADMIN_EMAIL=admin@eduportal.com
ADMIN_PASSWORD=replace_with_strong_password_min_12_chars
ADMIN_FULLNAME=System Administrator
